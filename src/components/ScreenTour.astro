---
import { Image } from "astro:assets";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import type { Screen } from "@/lib/projects";

type Props = { screens: Screen[]; label: string; liveUrl?: string; class?: string };

const { screens, label, liveUrl, class: className } = Astro.props;
const host = liveUrl ? new URL(liveUrl).host : undefined;
const button =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-md border px-5 text-sm font-medium transition-colors duration-200";
---

{/* Steps scroll past on the left while the app window stays in view on the right, showing the
    screen for whichever step is in the middle of the viewport. "Try it yourself" swaps the
    screenshots for the live app, inside the same window. */}
<section data-tour aria-label={label} class:list={["lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14", className]}>
  <ol class="space-y-14 lg:space-y-0">
    {
      screens.map((screen, i) => (
        <li
          data-step
          data-current={i === 0 ? "" : undefined}
          class="group reveal lg:flex lg:min-h-[75vh] lg:items-center lg:first:min-h-[60vh] lg:last:min-h-[60vh]"
        >
          <div class="border-l-2 border-line pl-6 transition-colors duration-500 group-data-[current]:border-lime">
            <span
              aria-hidden="true"
              class="inline-flex size-10 items-center justify-center rounded-md border border-line-strong text-sm font-semibold text-grey transition-colors duration-500 group-data-[current]:border-lime group-data-[current]:bg-lime group-data-[current]:text-obsidian"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-5 text-title text-grey transition-colors duration-500 group-data-[current]:text-offwhite">
              {screen.title}
            </h3>
            <p class="mt-3 max-w-md text-body text-grey transition-colors duration-500 group-data-[current]:text-offwhite/75">
              {screen.caption}
            </p>
          </div>

          {/* Small screens have no room for a pinned window, so each step carries its own screenshot. */}
          <div class="mt-6 overflow-hidden rounded-xl border border-line bg-elevated lg:hidden">
            <Image
              src={screen.image}
              alt={screen.alt}
              widths={[640, 1136]}
              sizes="100vw"
              class="aspect-[16/10] w-full object-cover object-left-top"
            />
          </div>
        </li>
      ))
    }
  </ol>

  <div class="max-lg:hidden">
    <div class="sticky top-[calc(50vh-17rem)]">
      <div class="overflow-hidden rounded-xl border border-line-strong bg-elevated shadow-[0_40px_120px_-40px_rgb(215_255_100/0.22)]">
        <div class="flex items-center gap-3 border-b border-line px-4 py-2.5">
          <span aria-hidden="true" class="flex gap-1.5">
            <span class="size-2.5 rounded-full bg-line-strong"></span>
            <span class="size-2.5 rounded-full bg-line-strong"></span>
            <span class="size-2.5 rounded-full bg-line-strong"></span>
          </span>
          <span class="flex-1 truncate rounded-md bg-obsidian px-3 py-1 text-center text-xs text-grey">
            {host ?? label}
          </span>
        </div>

        <div class="relative grid aspect-[16/10] overflow-hidden">
          <ul data-stage class="contents">
            {
              screens.map((screen, i) => (
                <li
                  data-slide
                  data-state={i === 0 ? "current" : undefined}
                  aria-hidden={i !== 0 ? "true" : undefined}
                  class="relative col-start-1 row-start-1 overflow-hidden"
                >
                  <Image
                    src={screen.image}
                    alt={screen.alt}
                    widths={[640, 1136, 1600]}
                    sizes="(min-width: 1216px) 680px, 58vw"
                    draggable="false"
                    class="absolute inset-0 size-full object-cover object-left-top"
                  />
                </li>
              ))
            }
          </ul>
          {/* Filled in on "Try it yourself", so the live app only loads for visitors who ask for it. */}
          <iframe
            data-live
            hidden
            title={`${label}: live app`}
            class="col-start-1 row-start-1 size-full bg-obsidian"
            referrerpolicy="no-referrer"></iframe>
        </div>
      </div>

      {
        liveUrl && (
          <div class="mt-6 flex flex-col items-center text-center">
            <p data-note="tour" class="max-w-md text-small text-grey">
              These are screens from the real app, changing as you scroll.
            </p>
            <p data-note="live" hidden class="max-w-md text-small text-grey">
              This is the live app. Google won&rsquo;t sign you in inside this window, so open it in a new tab to sign
              in.
            </p>
            <div class="mt-4 flex flex-wrap justify-center gap-3">
              <button type="button" data-try class:list={[button, "border-lime bg-lime text-obsidian hover:border-lime-hover hover:bg-lime-hover"]}>
                Try it yourself
              </button>
              <button type="button" data-back hidden class:list={[button, "border-line-strong text-offwhite hover:border-offwhite"]}>
                Back to the tour
              </button>
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener"
                data-open
                hidden
                class:list={["group", button, "border-line-strong text-offwhite hover:border-offwhite"]}
              >
                Open in a new tab
                <ArrowUpRight
                  aria-hidden="true"
                  class="size-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  stroke-width={1.75}
                />
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  [data-slide] {
    visibility: hidden;
  }
  [data-slide][data-state] {
    visibility: visible;
  }
  [data-slide][data-state="current"] {
    z-index: 2;
  }

  /* The new screen sharpens out of a blur while the last one sinks back. Effects run from the
     first change on, so the opening screen is simply there. */
  [data-animate] [data-slide][data-state] {
    animation: screen-focus 0.9s var(--ease-out-soft) both;
  }
  [data-animate] [data-slide][data-state="previous"] {
    animation-name: screen-recede;
  }
  [data-live]:not([hidden]) {
    position: relative;
    z-index: 3;
    animation: screen-focus 0.9s var(--ease-out-soft) both;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-animate] [data-slide][data-state],
    [data-live]:not([hidden]) {
      animation: none;
    }
  }

  @keyframes screen-focus {
    from { opacity: 0; transform: scale(1.12); filter: blur(16px); }
  }
  @keyframes screen-recede {
    to { transform: scale(0.94); filter: brightness(0.4); }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tour]")) {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const live = root.querySelector<HTMLIFrameElement>("[data-live]")!;
    const tryButton = root.querySelector<HTMLButtonElement>("[data-try]");
    const backButton = root.querySelector<HTMLButtonElement>("[data-back]");
    const openLink = root.querySelector<HTMLAnchorElement>("[data-open]");

    let index = 0;

    const show = (next: number) => {
      if (next === index) return;
      root.dataset.animate = "";
      slides.forEach((slide, n) => {
        if (n === next) slide.dataset.state = "current";
        else if (n === index) slide.dataset.state = "previous";
        else delete slide.dataset.state;
        slide.toggleAttribute("aria-hidden", n !== next);
      });
      steps.forEach((step, n) => step.toggleAttribute("data-current", n === next));
      index = next;
    };

    // A step becomes current as it crosses the middle of the viewport.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (entry.isIntersecting) show(steps.indexOf(entry.target as HTMLElement));
      },
      { rootMargin: "-50% 0px -50% 0px" },
    );
    steps.forEach((step) => observer.observe(step));

    const setLive = (on: boolean) => {
      if (on && !live.src && openLink) live.src = openLink.href;
      live.hidden = !on;
      tryButton!.hidden = on;
      backButton!.hidden = !on;
      openLink!.hidden = !on;
      root.querySelector<HTMLElement>('[data-note="tour"]')!.hidden = on;
      root.querySelector<HTMLElement>('[data-note="live"]')!.hidden = !on;
      (on ? backButton : tryButton)!.focus();
    };

    tryButton?.addEventListener("click", () => setLive(true));
    backButton?.addEventListener("click", () => setLive(false));
  }
</script>
